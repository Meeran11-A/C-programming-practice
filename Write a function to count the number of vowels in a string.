#include <stdio.h> 
int countVowels(char str[]) { 
int i = 0, count = 0; 
while(str[i]) { 
char ch = str[i]; 
if(ch >= 'A' && ch <= 'Z') 
ch += 32; 
if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u') 
count++; 
i++; 
} 
return count; 
} 
int main() { 
char str[100]; 
fgets(str, sizeof(str), stdin); 
printf("Vowels = %d", countVowels(str)); 
return 0; 
}