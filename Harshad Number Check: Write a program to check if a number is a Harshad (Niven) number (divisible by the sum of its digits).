#include <stdio.h>

int main() {
    int num, sum = 0, temp;

    printf("Enter a number: ");
    scanf("%d", &num);

    temp = num;

    // Calculate sum of digits
    while (temp > 0) {
        sum += temp % 10;
        temp /= 10;
    }

    // Check Harshad condition
    if (num % sum == 0) {
        printf("%d is a Harshad (Niven) number.\n", num);
    } else {
        printf("%d is NOT a Harshad (Niven) number.\n", num);
    }

    return 0;
}
