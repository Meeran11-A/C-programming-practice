#include <stdio.h>

void findIntersection(int *a, int n1, int *b, int n2) {
    printf("Intersection of arrays:\n");

    for (int i = 0; i < n1; i++) {
        for (int j = 0; j < n2; j++) {
            if (*(a + i) == *(b + j)) {
                // Check if already printed (to avoid duplicates)
                int duplicate = 0;
                for (int k = 0; k < i; k++) {
                    if (*(a + k) == *(a + i)) {
                        duplicate = 1;
                        break;
                    }
                }
                if (!duplicate) {
                    printf("%d ", *(a + i));
                }
            }
        }
    }
    printf("\n");
}

int main() {
    int a[5] = {1, 2, 3, 4, 5};
    int b[5] = {3, 4, 5, 6, 7};

    findIntersection(a, 5, b, 5);

    return 0;
}
