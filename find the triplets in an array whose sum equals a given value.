#include <stdio.h>

int main() {
    int n, target;

    scanf("%d", &n);
    int arr[n];

    for(int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    scanf("%d", &target);

    printf("Triplets:\n");

    for(int i = 0; i < n-2; i++) {
        for(int j = i+1; j < n-1; j++) {
            for(int k = j+1; k < n; k++) {

                if(arr[i] + arr[j] + arr[k] == target)
                    printf("%d %d %d\n", arr[i], arr[j], arr[k]);
            }
        }
    }

    return 0;
}