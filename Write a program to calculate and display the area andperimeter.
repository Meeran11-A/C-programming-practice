#include <stdio.h>

// Define structure
struct Rectangle {
    int length;
    int width;
};

int main() {
    // Declare and initialize structure variable
    struct Rectangle rect;
    rect.length = 5;
    rect.width = 3;

    // Calculate area and perimeter
    int area = rect.length * rect.width;
    int perimeter = 2 * (rect.length + rect.width);

    // Display results
    printf("Rectangle Details:\n");
    printf("Length: %d\n", rect.length);
    printf("Width: %d\n", rect.width);
    printf("Area: %d\n", area);
    printf("Perimeter: %d\n", perimeter);

    return 0;
}
