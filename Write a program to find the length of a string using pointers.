#include <stdio.h>

int main() {
    char str[100];
    char *ptr;
    int length = 0;

    printf("Enter a string: ");
    scanf("%s", str);

    // Initialize pointer to start of string
    ptr = str;

    // Traverse until null terminator
    while (*ptr != '\0') {
        length++;
        ptr++;  // move pointer to next character
    }

    printf("Length of the string \"%s\" = %d\n", str, length);

    return 0;
}
