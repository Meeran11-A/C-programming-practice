#include <stdio.h>

int main() {
    int arr[100], n;
    int *ptr;
    int sum = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Initialize pointer to start of array
    ptr = arr;

    // Traverse array using pointer arithmetic
    for (int i = 0; i < n; i++) {
        sum += *(ptr + i);  // add value pointed to
    }

    printf("Sum of array elements = %d\n", sum);

    return 0;
}
