#include <stdio.h>
#include <math.h>

int main() {
    int num;
    printf("Enter a number: ");
    scanf("%d", &num);

    long long square = (long long)num * num;  // compute square

    int temp = num;
    int digits = 0;

    // Count digits in num
    while (temp > 0) {
        digits++;
        temp /= 10;
    }

    // Extract last 'digits' digits from square
    int lastDigits = square % (int)pow(10, digits);

    if (lastDigits == num) {
        printf("%d is an Automorphic number (since %lld ends with %d).\n", num, square, num);
    } else {
        printf("%d is NOT an Automorphic number (since %lld does not end with %d).\n", num, square, num);
    }

    return 0;
}
