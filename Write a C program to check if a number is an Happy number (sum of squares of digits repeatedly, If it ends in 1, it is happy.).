#include <stdio.h>
int main() {
    int num, temp, sum, digit;
    printf("Enter a number: ");
    scanf("%d", &num);
    while (num != 1 && num != 4) {
        sum = 0;
        temp = num;
        while (temp > 0) {
            digit = temp % 10;
            sum += digit * digit;
            temp /= 10;
        }
        num = sum;
    }
    if (num == 1)
        printf("Happy Number\n");
    else
        printf("Not a Happy Number\n");
    return 0;
}
