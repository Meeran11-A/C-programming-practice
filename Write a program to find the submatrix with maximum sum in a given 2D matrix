#include <stdio.h>
#include <limits.h>

#define MAX 20

// Standard Kadane’s algorithm for 1D array
int kadane(int arr[], int n, int *start, int *end) {
    int sum = 0, maxSum = INT_MIN;
    int localStart = 0;
    *end = -1;

    for (int i = 0; i < n; i++) {
        sum += arr[i];
        if (sum < arr[i]) {
            sum = arr[i];
            localStart = i;
        }
        if (sum > maxSum) {
            maxSum = sum;
            *start = localStart;
            *end = i;
        }
    }
    if (*end != -1) return maxSum;
    return maxSum;
}

int main() {
    int m, n;
    int mat[MAX][MAX];

    printf("Enter rows and columns: ");
    scanf("%d %d", &m, &n);

    printf("Enter matrix elements:\n");
    for (int i = 0; i < m; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &mat[i][j]);

    int left, right, top, bottom;
    int maxSum = INT_MIN;

    // Temporary array to store row sums
    int temp[MAX];

    for (int l = 0; l < n; l++) {
        for (int r = l; r < n; r++) {
            for (int i = 0; i < m; i++) {
                temp[i] = 0;
            }
            for (int i = 0; i < m; i++) {
                for (int j = l; j <= r; j++) {
                    temp[i] += mat[i][j];
                }
            }

            int start, end;
            int sum = kadane(temp, m, &start, &end);

            if (sum > maxSum) {
                maxSum = sum;
                left = l;
                right = r;
                top = start;
                bottom = end;
            }
        }
    }

    printf("Maximum Sum Submatrix = %d\n", maxSum);
    printf("Submatrix coordinates: Top-Left(%d,%d