#include <stdio.h>

int main() {
    int n;
    scanf("%d",&n);

    int a[n];
    for(int i=0;i<n;i++)
        scanf("%d",&a[i]);

    int max=a[0], sec=a[0];

    for(int i=1;i<n;i++)
        if(a[i]>max) max=a[i];

    for(int i=0;i<n;i++)
        if(a[i]<max && (sec==max || a[i]>sec))
            sec=a[i];

    if(sec==max) printf("No second largest");
    else printf("%d",sec);

    return 0;
}