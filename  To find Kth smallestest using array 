#include <stdio.h>

// Simple function to sort array (Bubble Sort)
void sortArray(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

int main() {
    int n, k, arr[100];

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter K (position of smallest element): ");
    scanf("%d", &k);

    if (k <= 0 || k > n) {
        printf("Invalid K value!\n");
        return 0;
    }

    sortArray(arr, n);

    printf("The %dth smallest element is: %d\n", k, arr[k - 1]);

    return 0;
}
