#include <stdio.h>

int main() {
    int a[5] = {1, 2, 3, 4, 5};
    int b[5] = {3, 4, 5, 6, 7};
    int unionArr[10];
    int i, j, k = 0;

    // Copy all elements of a[] into unionArr
    for (i = 0; i < 5; i++) {
        unionArr[k++] = a[i];
    }

    // Copy elements of b[] into unionArr if not already present
    for (i = 0; i < 5; i++) {
        int found = 0;
        for (j = 0; j < k; j++) {
            if (b[i] == unionArr[j]) {
                found = 1;
                break;
            }
        }
        if (!found) {
            unionArr[k++] = b[i];
        }
    }

    // Print union
    printf("Union of arrays:\n");
    for (i = 0; i < k; i++) {
        printf("%d ", unionArr[i]);
    }
    printf("\n");

    return 0;
}
