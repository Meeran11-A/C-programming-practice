#include <stdio.h>
#include <string.h>

// Function to swap two characters
void swap(char *x, char *y) {
    char temp = *x;
    *x = *y;
    *y = temp;
}

// Recursive function to generate permutations
void permute(char *str, int l, int r) {
    if (l == r) {
        printf("%s\n", str);  // base case: one permutation
    } else {
        for (int i = l; i <= r; i++) {
            swap((str + l), (str + i));       // swap current index with loop index
            permute(str, l + 1, r);           // recurse for next position
            swap((str + l), (str + i));       // backtrack (undo swap)
        }
    }
}

int main() {
    char str[100];
    printf("Enter a string: ");
    scanf("%s", str);

    int n = strlen(str);
    printf("All permutations of %s are:\n", str);
    permute(str, 0, n - 1);

    return 0;
}
