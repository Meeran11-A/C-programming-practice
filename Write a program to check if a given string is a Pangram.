#include <stdio.h>

int main() {
    char str[300];
    int seen[26] = {0}, count = 0;

    fgets(str, sizeof(str), stdin);

    for(int i = 0; str[i]; i++) {
        char ch = str[i];

        if(ch >= 'A' && ch <= 'Z')
            ch += 32;  // convert to lowercase

        if(ch >= 'a' && ch <= 'z') {
            if(seen[ch - 'a'] == 0) {
                seen[ch - 'a'] = 1;
                count++;
            }
        }
    }

    if(count == 26)
        printf("Pangram");
    else
        printf("Not Pangram");

    return 0;
}