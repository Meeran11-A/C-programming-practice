#include <stdio.h>

int main() {
    int arr[] = {0, 1, 9, 8, 0, 2};
    int n = sizeof(arr) / sizeof(arr[0]);
    int i, count = 0;

    // Traverse the array. If element is non-zero, place it at 'count' index
    for (i = 0; i < n; i++) {
        if (arr[i] != 0) {
            arr[count++] = arr[i];
        }
    }

    // Fill remaining positions with zeros
    while (count < n) {
        arr[count++] = 0;
    }

    // Print the modified array
    printf("Array after moving zeros to the end: ");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
