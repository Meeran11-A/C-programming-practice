#include <stdio.h>

int main() {
    int N;
    printf("Enter the size of the square (N): ");
    scanf("%d", &N);

    for (int i = 0; i < N; i++) {          // rows
        for (int j = 0; j < N; j++) {      // columns
            printf("* ");
        }
        printf("\n");                      // move to next line
    }

    return 0;
}
