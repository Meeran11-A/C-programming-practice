#include <stdio.h>
#include <string.h>
#include <ctype.h>

void removeCommonChars(char str1[], char str2[]) {
    int present[256] = {0};  // Track characters from str2

    // Mark all characters present in str2
    for (int i = 0; str2[i] != '\0'; i++) {
        present[(unsigned char)str2[i]] = 1;
    }

    // Build new string for str1 without common characters
    int index = 0;
    for (int i = 0; str1[i] != '\0'; i++) {
        if (!present[(unsigned char)str1[i]]) {
            str1[index++] = str1[i];
        }
    }
    str1[index] = '\0';  // Null-terminate
}

int main() {
    char str1[100] = "hello";
    char str2[100] = "world";

    printf("Original String 1: %s\n", str1);
    printf("Original String 2: %s\n", str2);

    removeCommonChars(str1, str2);

    printf("String 1 after removing common characters: %s\n", str1);

    return 0;
}
