#include <stdio.h>

int main() {
    int n, i;
    int sumPos = 0, sumNeg = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    for (i = 0; i < n; i++) {
        if (arr[i] > 0) {
            sumPos += arr[i];
        } else if (arr[i] < 0) {
            sumNeg += arr[i];
        }
    }

    printf("Sum of positive numbers = %d\n", sumPos);
    printf("Sum of negative numbers = %d\n", sumNeg);

    return 0;
}
