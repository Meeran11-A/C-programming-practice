#include <stdio.h>

void sortArray(int *arr, int n) {
    int *i, *j, temp;

    for (i = arr; i < arr + n - 1; i++) {
        for (j = i + 1; j < arr + n; j++) {
            if (*i > *j) {
                // Swap values using pointers
                temp = *i;
                *i = *j;
                *j = temp;
            }
        }
    }
}

int main() {
    int arr[100], n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    sortArray(arr, n);

    printf("Array in ascending order: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", *(arr + i));  // printing using pointer arithmetic
    }
    printf("\n");

    return 0;
}
