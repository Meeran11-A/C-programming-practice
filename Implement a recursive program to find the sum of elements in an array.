#include <stdio.h>

// Recursive function to calculate sum of array elements
int sumArray(int *arr, int n) {
    if (n == 0) {
        return 0;  // base case: no elements
    } else {
        return *(arr + n - 1) + sumArray(arr, n - 1);  
        // add last element + sum of remaining
    }
}

int main() {
    int arr[100], n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Sum of array elements = %d\n", sumArray(arr, n));

    return 0;
}
