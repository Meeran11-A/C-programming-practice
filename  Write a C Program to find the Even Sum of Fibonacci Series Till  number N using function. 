#include <stdio.h> 
int evenFiboSum(int N) { 
    int a = 0, b = 1, next; 
    int sum = 0; 
    while (a <= N) { 
        if (a % 2 == 0) 
            sum += a; 
        next = a + b; 
        a = b; 
        b = next;  } 
   return sum;} 
int main() { 
    int N; 
    printf("Enter the value of N: "); 
    scanf("%d", &N); 
    printf("Sum of even Fibonacci numbers up to %d is %d\n", N, evenFiboSum(N)); 
 
    return 0; 
}