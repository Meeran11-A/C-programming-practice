#include <stdio.h>

// Function to sort the array (simple bubble sort for clarity)
void sortArray(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

int main() {
    int arr[] = {7, 10, 4, 3, 20, 15};
    int n = sizeof(arr) / sizeof(arr[0]);
    int K = 3;

    // Sort the array
    sortArray(arr, n);

    // Kth smallest is at index K-1
    int kth_smallest = arr[K - 1];

    // Kth largest is at index n-K
    int kth_largest = arr[n - K];

    printf("Kth smallest element (K=%d): %d\n", K, kth_smallest);
    printf("Kth largest element (K=%d): %d\n", K, kth_largest);

    return 0;
}
