#include <stdio.h>

int max(int a, int b) {
    return (a > b) ? a : b;
}

int findMaxSum(int arr[], int n) {
    if (n == 0) return 0;
    if (n == 1) return arr[0];

    int incl = arr[0];  // max sum including current element
    int excl = 0;       // max sum excluding current element
    int excl_new;

    for (int i = 1; i < n; i++) {
        // Current max excluding i
        excl_new = max(incl, excl);

        // Current max including i
        incl = excl + arr[i];
        excl = excl_new;
    }

    // Return maximum of incl and excl
    return max(incl, excl);
}

int main() {
    int arr[] = {5, 5, 10, 100, 10, 5};
    int n = sizeof(arr) / sizeof(arr[0]);

    printf("Array elements: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    int result = findMaxSum(arr, n);
    printf("\nMaximum sum of non-adjacent elements = %d\n", result);

    return 0;
}
