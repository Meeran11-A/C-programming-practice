#include <stdio.h>

int countPairsWithDiff(int arr[], int n, int diff) {
    int count = 0;

    // Check all pairs
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[j] - arr[i] == diff || arr[i] - arr[j] == diff) {
                printf("(%d, %d)\n", arr[i], arr[j]);
                count++;
            }
        }
    }

    return count;
}

int main() {
    int arr[] = {1, 5, 3, 4, 2};
    int n = sizeof(arr) / sizeof(arr[0]);
    int diff = 2;

    int result = countPairsWithDiff(arr, n, diff);
    printf("Total pairs with difference %d: %d\n", diff, result);

    return 0;
}
