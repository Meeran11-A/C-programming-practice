#include <stdio.h>

int main() {
    int N;
    printf("Enter the number of rows: ");
    scanf("%d", &N);

    for (int i = 1; i <= N; i++) {
        for (int j = 1; j <= i; j++) {
            printf("%d ", i);   // print row number i, repeated i times
        }
        printf("\n");           // move to next line
    }

    return 0;
}
