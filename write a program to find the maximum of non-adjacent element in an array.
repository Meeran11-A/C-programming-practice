#include <stdio.h>

int max(int a, int b) {
    return (a > b) ? a : b;
}

int findMaxSum(int arr[], int n) {
    if (n == 0) return 0;
    if (n == 1) return arr[0];

    int incl = arr[0];  // max sum including current element
    int excl = 0;       // max sum excluding current element
    int excl_new;

    for (int i = 1; i < n; i++) {
        // Current max excluding i
        excl_new = max(incl, excl);

        // Current max including i
        incl = excl + arr[i];
        excl = excl_new;
    }

    // Return maximum of incl and excl
    return max(incl, excl);
}

int main() {
    int n;
    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];
    printf("Enter elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int result = findMaxSum(arr, n);
    printf("Maximum sum of non-adjacent elements = %d\n", result);

    return 0;
}
