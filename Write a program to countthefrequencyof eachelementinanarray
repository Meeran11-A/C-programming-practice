#include <stdio.h>

int main() {
    int arr[] = {2, 2, 1, 5, 1, 3, 3};
    int n = sizeof(arr) / sizeof(arr[0]);
    int freq[n];  // Array to store frequencies
    int i, j;

    // Initialize frequency array
    for (i = 0; i < n; i++) {
        freq[i] = -1;
    }

    // Count frequencies
    for (i = 0; i < n; i++) {
        int count = 1;
        for (j = i + 1; j < n; j++) {
            if (arr[i] == arr[j]) {
                count++;
                freq[j] = 0; // Mark as visited
            }
        }
        if (freq[i] != 0) {
            freq[i] = count;
        }
    }

    // Print frequencies
    printf("Element frequencies:\n");
    for (i = 0; i < n; i++) {
        if (freq[i] != 0) {
            printf("%d: %d time%s\n", arr[i], freq[i], freq[i] > 1 ? "s" : "");
        }
    }

    return 0;
}
