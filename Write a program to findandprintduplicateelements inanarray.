#include <stdio.h>

int main() {
    int arr[] = {4, 2, 7, 2, 5, 4, 3, 7};
    int n = sizeof(arr) / sizeof(arr[0]);
    int i, j;

    printf("Duplicate elements in the array are: ");
    for (i = 0; i < n; i++) {
        for (j = i + 1; j < n; j++) {
            if (arr[i] == arr[j]) {
                printf("%d ", arr[i]);
                break; // Avoid printing the same duplicate multiple times
            }
        }
    }

    return 0;
}
