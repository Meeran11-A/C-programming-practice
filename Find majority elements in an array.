#include <stdio.h>

int main() {
    int n, count = 0, candidate;
    scanf("%d", &n);

    int arr[n];
    for(int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    // Find candidate
    for(int i = 0; i < n; i++) {
        if(count == 0)
            candidate = arr[i];

        count += (arr[i] == candidate) ? 1 : -1;
    }

    // Verify candidate
    count = 0;
    for(int i = 0; i < n; i++)
        if(arr[i] == candidate)
            count++;

    if(count > n/2)
        printf("Majority element = %d", candidate);
    else
        printf("No Majority element");

    return 0;
}