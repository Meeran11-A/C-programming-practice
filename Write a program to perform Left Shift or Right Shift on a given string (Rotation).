#include <stdio.h>
#include <string.h>

// Function to left rotate string by one position
void leftRotate(char str[]) {
    int n = strlen(str);
    char first = str[0];

    for (int i = 0; i < n - 1; i++) {
        str[i] = str[i + 1];
    }
    str[n - 1] = first;
}

// Function to right rotate string by one position
void rightRotate(char str[]) {
    int n = strlen(str);
    char last = str[n - 1];

    for (int i = n - 1; i > 0; i--) {
        str[i] = str[i - 1];
    }
    str[0] = last;
}

int main() {
    char str1[100] = "HELLO";
    char str2[100] = "WORLD";

    printf("Original String 1: %s\n", str1);
    leftRotate(str1);
    printf("After Left Rotation: %s\n", str1);

    printf("\nOriginal String 2: %s\n", str2);
    rightRotate(str2);
    printf("After Right Rotation: %s\n", str2);

    return 0;
}
