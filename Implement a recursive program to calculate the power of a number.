#include <stdio.h>

// Recursive function to calculate base^exp
long long power(int base, int exp) {
    if (exp == 0) {
        return 1;  // base case: anything^0 = 1
    } else {
        return base * power(base, exp - 1);  // recursive step
    }
}

int main() {
    int base, exp;

    printf("Enter base: ");
    scanf("%d", &base);

    printf("Enter exponent: ");
    scanf("%d", &exp);

    if (exp < 0) {
        printf("This program does not handle negative exponents.\n");
    } else {
        printf("%d^%d = %lld\n", base, exp, power(base, exp));
    }

    return 0;
}
