#include <stdio.h>
#include <string.h>

void removeDuplicates(char str[]) {
    int index = 0;              // Position for unique characters
    int seen[256] = {0};        // Track ASCII characters (0–255)

    for (int i = 0; str[i] != '\0'; i++) {
        if (seen[(unsigned char)str[i]] == 0) {
            str[index++] = str[i];   // Keep character if not seen before
            seen[(unsigned char)str[i]] = 1;
        }
    }
    str[index] = '\0';          // Null-terminate the new string
}

int main() {
    char str[100] = "programming";

    printf("Original string: %s\n", str);

    removeDuplicates(str);

    printf("String after removing duplicates: %s\n", str);

    return 0;
}
