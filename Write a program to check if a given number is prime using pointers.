#include <stdio.h>

int isPrime(int *num) {
    if (*num <= 1) return 0;  // 0 and 1 are not prime

    for (int i = 2; i <= *num / 2; i++) {
        if (*num % i == 0) {
            return 0;  // divisible → not prime
        }
    }
    return 1;  // prime
}

int main() {
    int n;
    int *ptr = &n;

    printf("Enter a number: ");
    scanf("%d", ptr);

    if (isPrime(ptr)) {
        printf("%d is a prime number.\n", *ptr);
    } else {
        printf("%d is not a prime number.\n", *ptr);
    }

    return 0;
}
