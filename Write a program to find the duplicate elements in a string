#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int freq[256] = {0};  // frequency array for ASCII characters

    printf("Enter a string: ");
    scanf("%s", str);

    for (int i = 0; str[i] != '\0'; i++) {
        freq[(unsigned char)str[i]]++;
    }

    printf("Duplicate characters: ");
    int found = 0;
    for (int i = 0; i < 256; i++) {
        if (freq[i] > 1) {
            printf("%c ", i);
            found = 1;
        }
    }

    if (!found) {
        printf("None");
    }
    printf("\n");

    return 0;
}
