#include <stdio.h>
#include <string.h>

void reverseWords(char str[]) {
    int len = strlen(str);
    int end = len, start;

    printf("Words in reverse order:\n");

    // Traverse string from end to start
    for (int i = len - 1; i >= 0; i--) {
        if (str[i] == ' ' || i == 0) {
            // Word boundary found
            start = (i == 0) ? i : i + 1;

            for (int j = start; j < end; j++) {
                printf("%c", str[j]);
            }

            if (i != 0) printf(" "); // Add space between words
            end = i;
        }
    }
    printf("\n");
}

int main() {
    char str[100] = "Hello world this is C";

    reverseWords(str);

    return 0;
}
