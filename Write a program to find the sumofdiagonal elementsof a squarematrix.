#include <stdio.h>

#define SIZE 3   // Matrix size (3x3 for this example)

int main() {
    int matrix[SIZE][SIZE] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    int sum = 0;

    // Calculate sum of principal diagonal
    for (int i = 0; i < SIZE; i++) {
        sum += matrix[i][i];
    }

    // Print matrix
    printf("Matrix:\n");
    for (int i = 0; i < SIZE; i++) {
        for (int j = 0; j < SIZE; j++) {
            printf("%d ", matrix[i][j]);
        }
        printf("\n");
    }

    // Print result
    printf("\nSum of principal diagonal elements: %d\n", sum);

    return 0;
}
