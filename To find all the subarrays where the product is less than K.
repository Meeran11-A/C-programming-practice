#include <stdio.h>

void printSubarrays(int arr[], int n, int K) {
    int start = 0;
    long long product = 1;

    for (int end = 0; end < n; end++) {
        product *= arr[end];

        // Shrink window until product < K
        while (product >= K && start <= end) {
            product /= arr[start];
            start++;
        }

        // Print all subarrays ending at 'end' with product < K
        for (int i = end; i >= start; i--) {
            printf("[");
            for (int j = i; j <= end; j++) {
                printf("%d", arr[j]);
                if (j < end) printf(", ");
            }
            printf("]\n");
        }
    }
}

int main() {
    int arr[] = {10, 5, 2, 6};
    int n = sizeof(arr) / sizeof(arr[0]);
    int K = 100;

    printf("Subarrays with product less than %d:\n", K);
    printSubarrays(arr, n, K);

    return 0;
}
