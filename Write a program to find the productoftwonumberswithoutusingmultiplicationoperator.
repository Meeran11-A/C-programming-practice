#include <stdio.h>

int multiply(int a, int b) {
    int result = 0;
    int positive = 1;

    // Handle negative numbers
    if (a < 0 && b < 0) {
        a = -a;
        b = -b;
    } else if (a < 0 || b < 0) {
        positive = 0;
        if (a < 0) a = -a;
        if (b < 0) b = -b;
    }

    // Add 'a' to result 'b' times
    for (int i = 0; i < b; i++) {
        result += a;
    }

    return positive ? result : -result;
}

