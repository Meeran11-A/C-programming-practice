#include <stdio.h>

int main() {
    int n, diff, count = 0;

    scanf("%d", &n);
    int a[n];

    for(int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &diff);

    for(int i = 0; i < n-1; i++) {
        for(int j = i+1; j < n; j++) {
            if(a[i] - a[j] == diff || a[j] - a[i] == diff)
                count++;
        }
    }

    printf("%d", count);

    return 0;
}