#include <stdio.h>

void rotateRightByOne(int arr[], int n) {
    int last = arr[n - 1];  // Store last element

    // Shift all elements one position to the right
    for (int i = n - 1; i > 0; i--) {
        arr[i] = arr[i - 1];
    }

    arr[0] = last;  // Put last element at the front
}

int main() {
    int arr[] = {1, 2, 3, 4, 5};
    int n = sizeof(arr) / sizeof(arr[0]);

    rotateRightByOne(arr, n);

    printf("Array after cyclic rotation: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}

