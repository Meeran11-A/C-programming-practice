#include <stdio.h>

int main() {
    char str[200];
    int i, j, k;

    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i]; i++) {
        for(j = i + 1; str[j]; ) {
            if(str[i] == str[j]) {
                for(k = j; str[k]; k++)
                    str[k] = str[k + 1];   // shift left
            } else {
                j++;
            }
        }
    }

    printf("%s", str);
    return 0;
}