#include <stdio.h>

int countInversions(int arr[], int n) {
    int count = 0;

    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[i] > arr[j]) {
                count++;
                printf("(%d, %d) ", arr[i], arr[j]); // Print the inversion pair
            }
        }
    }

    return count;
}

int main() {
    int arr[] = {2, 4, 1, 3, 5};
    int n = sizeof(arr) / sizeof(arr[0]);

    printf("Inversion pairs: ");
    int result = countInversions(arr, n);

    printf("\nTotal number of inversions: %d\n", result);

    return 0;
}
