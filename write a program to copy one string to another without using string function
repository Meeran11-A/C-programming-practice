#include <stdio.h>

int main() {
    char str1[100], str2[100];
    int i;

    printf("Enter a string: ");
    fgets(str1, sizeof(str1), stdin);

    // Copy manually without using strcpy()
    for (i = 0; str1[i] != '\0'; i++) {
        str2[i] = str1[i];
    }
    str2[i] = '\0';  // Add null terminator

    printf("Original string: %s", str1);
    printf("Copied string: %s", str2);

    return 0;
}
