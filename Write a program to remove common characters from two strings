#include <stdio.h>
#include <string.h>

int main() {
    char str1[100], str2[100];
    int i, j, found;

    printf("Enter first string: ");
    scanf("%s", str1);

    printf("Enter second string: ");
    scanf("%s", str2);

    printf("After removing common characters:\n");

    // Print characters from str1 not in str2
    printf("String 1: ");
    for (i = 0; str1[i] != '\0'; i++) {
        found = 0;
        for (j = 0; str2[j] != '\0'; j++) {
            if (str1[i] == str2[j]) {
                found = 1;
                break;
            }
        }
        if (!found)
            printf("%c", str1[i]);
    }

    // Print characters from str2 not in str1
    printf("\nString 2: ");
    for (i = 0; str2[i] != '\0'; i++) {
        found = 0;
        for (j = 0; str1[j] != '\0'; j++) {
            if (str2[i] == str1[j]) {
                found = 1;
                break;
            }
        }
        if (!found)
            printf("%c", str2[i]);
    }

    return 0;
}