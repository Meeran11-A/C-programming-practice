#include <stdio.h>

// Function to compute GCD using Euclidean algorithm
int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

// Function to compute LCM using GCD
int lcm(int a, int b) {
    return (a * b) / gcd(a, b);
}

int main() {
    int n;
    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Initialize HCF and LCM with first element
    int hcf = arr[0];
    int lcmVal = arr[0];

    // Compute HCF and LCM iteratively
    for (int i = 1; i < n; i++) {
        hcf = gcd(hcf, arr[i]);
        lcmVal = lcm(lcmVal, arr[i]);
    }

    printf("HCF of the list = %d\n", hcf);
    printf("LCM of the list = %d\n", lcmVal);

    return 0;
}
