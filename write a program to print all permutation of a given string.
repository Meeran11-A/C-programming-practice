#include <stdio.h>
#include <string.h>

// Function to swap characters
void swap(char *x, char *y) {
    char temp = *x;
    *x = *y;
    *y = temp;
}

// Recursive function to generate permutations
void permute(char *str, int l, int r) {
    if (l == r) {
        printf("%s\n", str);
    } else {
        for (int i = l; i <= r; i++) {
            swap(&str[l], &str[i]);       // Swap current index with i
            permute(str, l + 1, r);       // Recurse for next index
            swap(&str[l], &str[i]);       // Backtrack (undo swap)
        }
    }
}

int main() {
    char str[] = "ABC";
    int n = strlen(str);

    printf("Permutations of %s are:\n", str);
    permute(str, 0, n - 1);

    return 0;
}
