#include <stdio.h>

int main() {
    char str[100], rev[100];
    int i, j, len = 0;

    printf("Enter a string: ");
    scanf("%s", str);

    // Find length manually
    while (str[len] != '\0') {
        len++;
    }

    // Reverse copy
    j = 0;
    for (i = len - 1; i >= 0; i--) {
        rev[j++] = str[i];
    }
    rev[j] = '\0';  // Null terminate

    printf("Original string: %s\n", str);
    printf("Reversed string: %s\n", rev);

    return 0;
}
