#include <stdio.h>

int main() {
    int arr[] = {12, 45, 67, 23, 89, 34};
    int n = sizeof(arr) / sizeof(arr[0]);
    int max = arr[0];  // Assume first element is maximum

    for (int i = 1; i < n; i++) {
        if (arr[i] > max) {
            max = arr[i];
        }
    }

    printf("The maximum element in the array is: %d\n", max);

    return 0;
}
